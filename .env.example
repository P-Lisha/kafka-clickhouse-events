# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=events-service
KAFKA_TOPIC_EVENTS=events.raw
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_CONSUMER_GROUP=events-consumer-group
KAFKA_TOPIC_PARTITIONS=6
KAFKA_DLQ_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1
KAFKA_RETENTION_MS=604800000
KAFKA_DLQ_RETENTION_MS=1209600000
KAFKA_MAX_RETRIES=3

# API
API_PORT=4000
API_AUTH_TOKEN=changeme-dev-token

# Consumer worker's own /metrics endpoint (separate process from the API)
CONSUMER_METRICS_PORT=4001

# Storage toggle: false = Version 1 (queue only), true = Version 2 (+ ClickHouse)
STORAGE_ENABLED=false

# ClickHouse (only used when STORAGE_ENABLED=true)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TABLE=events
CLICKHOUSE_BATCH_SIZE=500
CLICKHOUSE_FLUSH_MS=2000
